# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only, NEVER expose with NEXT_PUBLIC_).
# Required for the server to write verified subscription state (Razorpay
# payments, webhooks, activation key redemption) — see lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: comma-separated override for the support/master activation keys
# validated in app/api/activation/redeem/route.ts. Rotate these periodically.
# ACTIVATION_MASTER_KEYS=TIVERA-UNLIMITED-PRO,TIVERA-VIP-UNLIMITED

# Gemini AI Vision Key
GEMINI_API_KEY=your-gemini-api-key

# App Base URLs
NEXT_PUBLIC_APP_URL=https://tivera.vercel.app
NEXT_PUBLIC_SITE_URL=https://tivera.vercel.app

# Razorpay Production / Test Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Frontend (Vercel) -> Backend (Render) wiring ---
# URL of the deployed FastAPI backend (backend/main.py), e.g. a Render service
# like https://tivera-backend.onrender.com. Read by app/api/scan-measurements
# and lib/scanner/gemini.js. Defaults to http://localhost:8000 if unset, which
# only works for local dev — set this in Vercel's env vars for production.
NEXT_PUBLIC_PYTHON_BACKEND_URL=https://your-backend.onrender.com

# --- Backend (Render) only — set this on the Render service, not Vercel ---
# Comma-separated list of origins allowed to call the FastAPI backend's CORS
# policy (backend/main.py). Must include your deployed frontend origin.
# ALLOWED_ORIGINS=https://tivera.vercel.app
